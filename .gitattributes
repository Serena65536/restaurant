# 统一换行符，避免 Windows 上每次 git 操作都刷一堆
# "LF will be replaced by CRLF" 警告
* text=auto eol=lf

# PowerShell 脚本必须是 LF：BOM-less UTF-8 + 换行混用会让
# Windows PowerShell 5.1 解析出错（本项目踩过这个坑）
*.ps1 text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.jar binary
*.keystore binary
